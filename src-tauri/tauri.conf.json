{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuwnote",
  "version": "2.0.0",
  "identifier": "org.ruject.kuwnote",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kuwnote",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Kuwnote - Modern modular workspace note-taking app",
    "longDescription": "Kuwnote is an offline-ready modular workspace note-taking application featuring rich blocks, customizable layouts, and plugin extensibility.",
    "category": "Office",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
